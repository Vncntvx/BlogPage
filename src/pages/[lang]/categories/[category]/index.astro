---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/layouts/Main.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { slugifyStr } from "@/utils/slugify";
import { getTaxonomy } from "@/utils/taxonomy";
import { SITE } from "@/config";
import { t } from "@/i18n/utils";
import { SUPPORTED_LOCALES } from "@/i18n/config";
import { DEFAULT_CATEGORY_SLUG } from "@/utils/getUniqueCategories";
import type { LocaleCode } from "@/i18n/config";

interface PathProps {
  categoryName: string;
  locale: LocaleCode;
}

export async function getStaticPaths() {
  if (!SITE.pages.categories.enabled) return [];
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  const paths = SUPPORTED_LOCALES.flatMap(locale => {
    const localePosts = posts.filter(post => post.data.lang === locale.code);
    // 使用 getTaxonomy 统一去重（首写胜出），与聚合页显示名保持一致；
    // 默认分类 General 经 defaultLabel 本地化（与 getUniqueCategories 行为一致）。
    const categories = getTaxonomy(localePosts, "category", {
      defaultLabel: t("defaultCategory", locale.code),
      defaultSlug: DEFAULT_CATEGORY_SLUG,
    });

    return categories.map(({ slug, name }) => ({
      params: { lang: locale.path, category: slug },
      props: { categoryName: name, locale: locale.code } satisfies PathProps,
    }));
  });

  return paths;
}

if (!SITE.pages.categories.enabled) {
  return Astro.redirect("/404", 308);
}

const { categoryName, locale } = Astro.props as PathProps;
const { category } = Astro.params;

const posts = await getCollection(
  "blog",
  ({ data }) =>
    data.lang === locale &&
    !data.draft &&
    slugifyStr(data.category || "") === category
);
const sortedPosts = getSortedPosts(posts);

const displayCategoryName =
  slugifyStr(categoryName || "") === DEFAULT_CATEGORY_SLUG
    ? t("defaultCategory", locale)
    : categoryName;
---

<Layout
  title={`${displayCategoryName} | ${t("categoryTitle", locale)} | ${SITE.title}`}
>
  <Header />
  <Main
    pageTitle={`${t("categoryTitle", locale)} ${displayCategoryName}`}
    pageDesc={t("categoryDescription", locale)}
  >
    {
      sortedPosts.length === 0 ? (
        <p class="text-muted-foreground italic">{t("noCategories", locale)}</p>
      ) : (
        <ul>
          {sortedPosts.map(data => (
            <Card variant="h3" {...data} />
          ))}
        </ul>
      )
    }
  </Main>
  <Footer />
</Layout>
