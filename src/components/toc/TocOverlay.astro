---
import TocList from "@/components/toc/TocList.astro";
import type { TocNode } from "@/utils/toc";
import { t } from "@/i18n";
import type { LocaleCode } from "@/i18n/config";

interface Props {
  tree: TocNode[];
  locale: LocaleCode;
}

const { tree, locale } = Astro.props;
const label = t("tableOfContents", locale);
const closeLabel = t("tocClose", locale);
---

{
  /* Shared TOC overlay — one markup, two positions:
     - tablet (md…xl): right-side drawer, width min(360px, 88vw)
     - mobile (<md): bottom sheet, max-h 75dvh
     Variant is chosen by CSS at runtime via the [data-toc-overlay-variant]
     attribute, toggled by the open script based on which trigger was used /
     the current breakpoint. Focus is trapped, Escape closes, background scroll
     is locked, and focus returns to the trigger on close. Links jump + close. */
}
<div
  class="toc-overlay fixed inset-0 z-50"
  data-toc-overlay
  data-toc-overlay-variant="drawer"
  data-pagefind-ignore
  hidden
>
  {
    /* Backdrop：正文毛玻璃——半透明黑遮罩 + backdrop-blur，透出模糊的正文
      （对齐 PostDetails lightbox 的 backdrop-blur-sm，但用 /50 比 lightbox /70
      轻，让正文更可见）。panel 仍 bg-background 不透明，目录文字清晰。 */
  }
  <div
    class="toc-overlay__backdrop absolute inset-0 bg-black/50 opacity-0 backdrop-blur-sm"
    data-toc-overlay-backdrop
    aria-hidden="true"
  >
  </div>

  {/* Panel */}
  <div
    class="toc-overlay__panel absolute flex flex-col overflow-hidden border-border bg-background shadow-xl"
    role="dialog"
    aria-modal="true"
    aria-label={label}
    data-toc-overlay-panel
  >
    <div
      class="flex items-center justify-between border-b border-border px-4 py-3"
    >
      <span class="text-sm font-semibold text-foreground/80">{label}</span>
      <button
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md text-foreground/60 transition-colors hover:bg-muted hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-accent focus-visible:outline-dashed"
        data-toc-overlay-close
        aria-label={closeLabel}
      >
        <svg
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="toc-overlay__body overflow-y-auto p-3" data-toc-overlay-body>
      <TocList tree={tree} variant="drawer" locale={locale} />
    </div>
  </div>
</div>

<style is:global>
  /* 态机：可见态由 .is-open class 控制（终态），[hidden] 只管 display:none
     （彻底隐藏）。分离二者后，关闭时先移除 .is-open 触发回初态的过渡，
     等 transitionend 再 setAttribute(hidden)——关闭过渡才能真正播放，
     不再被 display:none 立即掐断（原先关闭是 setTimeout 后硬切）。 */

  /* backdrop：先于 panel 到位——150ms < panel 220/280ms，同时开始先完成。
     用「更短时长」而非 transition-delay，避免关闭方向也被延迟。 */
  .toc-overlay__backdrop {
    transition: opacity 150ms var(--ease-out);
  }
  .toc-overlay.is-open .toc-overlay__backdrop {
    opacity: 1;
  }

  /* Drawer（平板）：右侧原位淡入 + 微缩放 + 微左移。不再从屏外整块滑入，
     去「机械滑入感」，对齐 SaaS 文档站 modal 的「浮出」质感。
     scale 合并在 transform 内（非独立 scale 属性），故 transitionend 的
     propertyName 为 transform，便于脚本过滤。 */
  .toc-overlay[data-toc-overlay-variant="drawer"] .toc-overlay__panel {
    top: 0;
    right: 0;
    bottom: 0;
    width: min(360px, 88vw);
    border-left-width: 1px;
    opacity: 0;
    transform: translateX(16px) scale(0.96);
    transition:
      opacity 220ms var(--ease-out),
      transform 220ms var(--ease-out);
  }
  .toc-overlay[data-toc-overlay-variant="drawer"].is-open .toc-overlay__panel {
    opacity: 1;
    transform: translateX(0) scale(1);
  }

  /* Sheet（手机）：保留上滑 + iOS 曲线（轻微过冲），符合手机操作习惯。 */
  .toc-overlay[data-toc-overlay-variant="sheet"] .toc-overlay__panel {
    left: 0;
    right: 0;
    bottom: 0;
    max-height: 75dvh;
    border-top-width: 1px;
    border-top-left-radius: 0.75rem;
    border-top-right-radius: 0.75rem;
    transform: translateY(100%);
    transition: transform 280ms var(--ease-ios);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .toc-overlay[data-toc-overlay-variant="sheet"].is-open .toc-overlay__panel {
    transform: translateY(0);
  }

  /* reduced-motion：unlayered 简写会压过 utility 的 motion-reduce:transition-none，
     故在此显式归零，覆盖上面的 transition 声明。 */
  @media (prefers-reduced-motion: reduce) {
    .toc-overlay__panel,
    .toc-overlay__backdrop {
      transition: none !important;
    }
  }
</style>
