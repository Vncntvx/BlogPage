---
import TocList from "@/components/toc/TocList.astro";
import type { TocNode } from "@/utils/toc";
import type { LocaleCode } from "@/i18n/config";
import { t } from "@/i18n";

interface Props {
  tree: TocNode[];
  locale: LocaleCode;
}

const { tree, locale } = Astro.props;
const tocLabel = t("tableOfContents", locale);
---

{
  /* Desktop rail (xl+). 绝对定位在正文左侧留白里（不是重居中的网格列），
     因此绝不改变阅读列的位置与宽度。外层 .toc-rail 铺满 .post-article-wrapper
     高度（top/bottom:0）作为 sticky 的包含块；内层 <aside> 用 sticky 随滚动
     行走并在过高时自滚动。rail 列本身 pointer-events:none，aside 重新开启，
     不挡左侧留白的点击。显隐由 global.css 的视口媒体查询驱动（≥1280 显示）。 */
}
<div class="toc-rail" data-toc-rail aria-hidden="true">
  <aside class="toc-sidebar" data-toc-sidebar>
    <p
      class="mb-2 ps-2 text-xs font-semibold tracking-wide text-foreground/50 uppercase"
    >
      {tocLabel}
    </p>
    <TocList tree={tree} variant="sidebar" locale={locale} />
  </aside>
</div>

<style is:global>
  .toc-rail {
    position: absolute;
    top: 0;
    bottom: 0;
    /* 活在正文左侧留白：右边界紧贴正文左缘 + 间距 */
    right: calc(100% + var(--toc-gap));
    width: var(--toc-rail-width);
    pointer-events: none;
    /* 显隐由 global.css 视口媒体查询统一管理（此处不设 display，避免与
       global.css 的 @media 规则因注入顺序互相覆盖） */
  }
  .toc-rail .toc-sidebar {
    position: sticky;
    top: 1rem;
    max-height: calc(100svh - 1.5rem);
    overflow-y: auto;
    pointer-events: auto;
  }
</style>
