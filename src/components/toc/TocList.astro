---
import type { TocNode } from "@/utils/toc";
import type { LocaleCode } from "@/i18n/config";
import { t } from "@/i18n";

interface Props {
  tree: TocNode[];
  /** Used to namespace DOM ids/hooks when multiple TOC instances coexist. */
  variant: "sidebar" | "drawer" | "sheet";
  locale: LocaleCode;
}

const { tree, variant, locale } = Astro.props;
const tocLabel = t("tableOfContents", locale);
---

<nav
  class:list={["toc-list", `toc-list--${variant}`]}
  aria-label={tocLabel}
  data-toc-list
  data-toc-variant={variant}
  data-pagefind-ignore
>
  <ul class="list-none space-y-0.5">
    {
      tree.map(node => (
        <li>
          <a
            href={`#${node.slug}`}
            class="toc-link block border-s-2 border-transparent py-1 ps-2 text-sm leading-snug text-foreground/70 transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-accent focus-visible:outline-dashed"
            data-toc-slug={node.slug}
            data-toc-depth={node.depth}
          >
            <span class="toc-link-text line-clamp-2">{node.text}</span>
          </a>
          {node.children.length > 0 && (
            <ul class="ms-3 mt-0.5 list-none space-y-0.5 border-s border-border/60 ps-2">
              {node.children.map(child => (
                <li>
                  <a
                    href={`#${child.slug}`}
                    class="toc-link block border-s-2 border-transparent py-1 ps-2 text-xs leading-snug text-foreground/70 transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-accent focus-visible:outline-dashed"
                    data-toc-slug={child.slug}
                    data-toc-depth={child.depth}
                  >
                    <span class="toc-link-text line-clamp-2">{child.text}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
</nav>

<style is:global>
  /* Active (current) item cue: left bar + weight + color + background, never
     color alone. Inlined here (unlayered + !important) so it reliably beats
     Tailwind's @layer utilities regardless of HMR/layer ordering in dev. */
  .toc-link[aria-current="location"] {
    border-color: var(--accent) !important;
    color: var(--accent) !important;
    font-weight: 600 !important;
    background-color: color-mix(
      in oklab,
      var(--muted) 40%,
      transparent
    ) !important;
  }
</style>
