---
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";
import { t, getLangFromUrl } from "@/i18n";

const currentYear = new Date().getFullYear();
const copyrightYear = currentYear > 2022 ? `2022-${currentYear}` : "2022";
const currentLocale = getLangFromUrl(Astro.url);

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class:list={["w-full", { "mt-auto": !noMarginTop }]}>
  <Hr noPadding />
  <div
    class="flex flex-col items-center justify-between py-6 sm:flex-row-reverse sm:py-4"
  >
    <Socials centered />
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span>{t("copyright", currentLocale)} &#169; {copyrightYear}</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span>{t("allRightsReserved", currentLocale)}</span>
    </div>
  </div>
</footer>
