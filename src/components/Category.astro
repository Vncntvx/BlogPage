---
import { getLangFromUrl, t } from "@/i18n/utils";
import { SITE } from "@/config";

export interface Props {
  /** 分类 slug（用于 URL）。旧名 category 作为兼容别名。 */
  slug?: string;
  /** 分类显示名。旧名 categoryName 作为兼容别名。 */
  name?: string;
  /** 文章数量，仅在聚合页传入。 */
  count?: number;
  /** 可选分类描述，当前无数据源，预留位。 */
  description?: string;
  /** @deprecated 使用 slug 代替。 */
  category?: string;
  /** @deprecated 使用 name 代替。 */
  categoryName?: string;
  size?: "sm" | "lg";
  lang?: string;
}

const {
  slug,
  name,
  count,
  description,
  category,
  categoryName,
  size = "sm",
  lang,
} = Astro.props;

// 兼容旧 prop 名。
const termSlug = slug ?? category ?? "";
const termName = name ?? categoryName ?? "";
const currentLang = lang || getLangFromUrl(Astro.url);
const enabled = SITE.pages.categories.enabled;
const href = `/${currentLang}/categories/${termSlug}/`;

const countVisible = typeof count === "number";
const countText = countVisible
  ? t("postCount", currentLang).replace("{count}", String(count))
  : "";
---

<li class="group">
  {
    enabled ? (
      <a
        href={href}
        transition:name={termSlug}
        class:list={[
          "flex items-baseline justify-between gap-3 py-3 text-foreground hover:text-accent focus-visible:no-underline",
          { "py-1.5": size === "sm" },
        ]}
      >
        <span class="min-w-0">
          <span
            class:list={[{ "font-semibold": size === "lg" }, "break-words"]}
          >
            {termName}
          </span>
          {description && (
            <span class="text-muted-foreground mt-0.5 block text-sm break-words">
              {description}
            </span>
          )}
        </span>
        {countVisible && (
          <span class="text-muted-foreground shrink-0 text-sm tabular-nums">
            {countText}
          </span>
        )}
      </a>
    ) : (
      <span
        class:list={[
          "text-muted-foreground flex items-baseline justify-between gap-3 py-3",
          { "py-1.5": size === "sm" },
        ]}
      >
        <span class="min-w-0">
          <span
            class:list={[{ "font-semibold": size === "lg" }, "break-words"]}
          >
            {termName}
          </span>
        </span>
        {countVisible && (
          <span class="text-muted-foreground shrink-0 text-sm tabular-nums">
            {countText}
          </span>
        )}
      </span>
    )
  }
</li>
