---
import IconHash from "@/assets/icons/IconHash.svg";
import { getLangFromUrl, t } from "@/i18n/utils";
import { SITE } from "@/config";

export interface Props {
  /** 标签 slug（用于 URL）。旧名 tag 作为兼容别名。 */
  slug?: string;
  /** 标签显示名。旧名 tagName 作为兼容别名。 */
  name?: string;
  /** 文章数量，仅在聚合页传入；详情页不传则不显示计数。 */
  count?: number;
  /** @deprecated 使用 slug 代替。 */
  tag?: string;
  /** @deprecated 使用 name 代替。 */
  tagName?: string;
  size?: "sm" | "lg";
  lang?: string;
}

const { slug, name, count, tag, tagName, size = "sm", lang } = Astro.props;

// 兼容旧 prop 名（PostDetails.astro 仍用 tag/tagName）。
const termSlug = slug ?? tag ?? "";
const termName = name ?? tagName ?? "";
const currentLang = lang || getLangFromUrl(Astro.url);
const enabled = SITE.pages.tags.enabled;
const href = `/${currentLang}/tags/${termSlug}/`;

// 数量文案：聚合页可视用 "· {count}"，aria-label 用本地化完整文案。
const countVisible = typeof count === "number";
const ariaLabel = countVisible
  ? t("postCount", currentLang).replace("{count}", String(count))
  : termName;
---

<li class="group inline-flex">
  {
    enabled ? (
      <a
        href={href}
        transition:name={termSlug}
        aria-label={ariaLabel}
        class:list={[
          "inline-flex items-baseline gap-1.5 rounded px-2 py-2.5 text-foreground decoration-dashed underline-offset-4 hover:text-accent hover:underline focus-visible:no-underline",
          { "text-sm": size === "sm" },
          { "text-base": size === "lg" },
        ]}
      >
        <IconHash
          class:list={[
            "size-4 shrink-0 self-center opacity-70 group-hover:opacity-100",
          ]}
          aria-hidden="true"
        />
        <span class="break-words">{termName}</span>
        {countVisible && (
          <span
            class="text-muted-foreground text-sm tabular-nums"
            aria-hidden="true"
          >
            · {count}
          </span>
        )}
      </a>
    ) : (
      <span
        class:list={[
          "text-muted-foreground inline-flex items-baseline gap-1.5 rounded px-2 py-2.5",
          { "text-sm": size === "sm" },
          { "text-base": size === "lg" },
        ]}
      >
        <IconHash
          class="size-4 shrink-0 self-center opacity-70"
          aria-hidden="true"
        />
        <span class="break-words">{termName}</span>
        {countVisible && (
          <span
            class="text-muted-foreground text-sm tabular-nums"
            aria-hidden="true"
          >
            · {count}
          </span>
        )}
      </span>
    )
  }
</li>
