---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Layout from "./Layout.astro";
import { SITE, LATEX } from "@/config";
import Comments from "@/components/Comments.astro";
import KatexStyles from "@/components/KatexStyles.astro";

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
  locale?: string;
}

const { frontmatter, locale } = Astro.props;
---

<Layout title={`${frontmatter.title} | ${SITE.title}`}>
  {LATEX.enabled && <KatexStyles />}
  <Header />
  <Breadcrumb />
  <main id="main-content">
    <section id="about" class="app-prose mb-28 max-w-app prose-img:border-0">
      <h1 class="text-2xl tracking-wider sm:text-3xl">{frontmatter.title}</h1>
      <slot />
    </section>
    <section class="max-w-app px-4 pb-16">
      <Comments locale={locale} />
    </section>
  </main>
  <Footer />
</Layout>
