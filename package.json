{
  "name": "astro-paper",
  "type": "module",
  "version": "5.5.0",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  },
  "trustedDependencies": [
    "@resvg/resvg-js",
    "sharp",
    "satori"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist && ([ -d public/pagefind ] || cp -r dist/pagefind public/)",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrolib/analytics": "^0.6.1",
    "@nullpinter/satteri-katex": "^0.1.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "dayjs": "^1.11.21",
    "giscus": "^1.6.0",
    "js-yaml": "^4.3.0",
    "katex": "^0.16.47",
    "lodash.kebabcase": "^4.1.1",
    "satori": "^0.26.0",
    "satteri-callouts": "^1.0.0",
    "sharp": "^0.34.5",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
